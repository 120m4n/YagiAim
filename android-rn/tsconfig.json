{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["jest", "node"]
  },
  "include": ["index.ts", "App.tsx", "src", "__tests__", "modules/**/src"],
  "exclude": ["node_modules", "android"]
}
